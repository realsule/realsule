# Copy this file to .env (same folder) and fill in real values.
# .env is already in .gitignore -- never commit your real one.
#
# This project has NO backend and NO third-party services, so there is
# exactly one variable, and it is not a "real" secret -- see the big
# comment in src/admin/AdminAuthContext.tsx for exactly why. Vite only
# reads variables prefixed VITE_, and only at BUILD time (they get
# baked into the JS bundle, not read at server runtime).

# Password for the /admin content studio. Change this to something only
# you know before you deploy anywhere public. If left unset, the app
# falls back to "changeme123" and prints a console warning in
# production builds so you don't forget.
VITE_ADMIN_PASSWORD=changeme123
